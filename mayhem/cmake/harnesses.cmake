# mh_harness(<name> <source> [LIBS ...] [DEFS ...] [OBJECTS ...] [INCLUDES ...])
# Builds /mayhem/<name> (libFuzzer) and /mayhem/<name>-standalone (run-once reproducer).
function(mh_harness name src)
  cmake_parse_arguments(A "" "" "LIBS;DEFS;OBJECTS;INCLUDES" ${ARGN})
  foreach(variant fuzz standalone)
    set(tgt "mh_${name}_${variant}")
    set(srcs "${MH_DIR}/harnesses/${src}" $<TARGET_OBJECTS:mh_lsan_off> ${A_OBJECTS})
    if(variant STREQUAL "standalone")
      list(APPEND srcs $<TARGET_OBJECTS:mh_standalone_main>)
      set(out "${name}-standalone")
    else()
      set(out "${name}")
    endif()
    add_executable(${tgt} ${srcs})
    set_target_properties(${tgt} PROPERTIES CXX_STANDARD 20 OUTPUT_NAME "${out}"
                          RUNTIME_OUTPUT_DIRECTORY "${CMAKE_SOURCE_DIR}/mayhem/bin")
    target_include_directories(${tgt} PRIVATE
      "${MH_DIR}/harnesses" "${CMAKE_SOURCE_DIR}/core/src"
      "${CMAKE_BINARY_DIR}/core/src" ${A_INCLUDES})
    target_compile_definitions(${tgt} PRIVATE ${A_DEFS})
    target_link_libraries(${tgt} PRIVATE ${A_LIBS})
    if(variant STREQUAL "fuzz")
      separate_arguments(engine UNIX_COMMAND "${MH_ENGINE}")
      target_compile_options(${tgt} PRIVATE ${engine})
      target_link_options(${tgt} PRIVATE ${engine})
    endif()
    set_property(GLOBAL APPEND PROPERTY MH_ALL_TARGETS ${tgt})
  endforeach()
endfunction()


# clang 19 + libstdc++ rejects each daemon's authenticate.cc (std::optional::emplace on a struct with
# member initializers), so the daemon objects are rebuilt from the same source list with that file
# compiled by g++ (<out>_auth).
function(mh_daemon_objs out tgt)
  get_target_property(srcdir ${tgt} SOURCE_DIR)
  get_target_property(srcs ${tgt} SOURCES)
  set(abs "")
  foreach(s IN LISTS srcs)
    if(NOT s MATCHES "authenticate\\.cc$")
      cmake_path(ABSOLUTE_PATH s BASE_DIRECTORY "${srcdir}" NORMALIZE OUTPUT_VARIABLE a)
      list(APPEND abs "${a}")
    endif()
  endforeach()
  add_library(${out} OBJECT ${abs})
  add_library(${out}_auth OBJECT "${srcdir}/authenticate.cc")
  set_target_properties(${out} ${out}_auth PROPERTIES CXX_STANDARD 20)
  set_target_properties(${out}_auth PROPERTIES CXX_COMPILER_LAUNCHER "${MH_DIR}/cmake/gcc-launcher.sh")
  foreach(prop INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_LIBRARIES)
    get_target_property(v ${tgt} ${prop})
    if(v)
      if(prop STREQUAL "INCLUDE_DIRECTORIES")
        target_include_directories(${out} PUBLIC ${v})
        target_include_directories(${out}_auth PUBLIC ${v})
      elseif(prop STREQUAL "COMPILE_DEFINITIONS")
        target_compile_definitions(${out} PUBLIC ${v})
        target_compile_definitions(${out}_auth PUBLIC ${v})
      elseif(prop STREQUAL "COMPILE_OPTIONS")
        target_compile_options(${out} PUBLIC ${v})
        target_compile_options(${out}_auth PUBLIC ${v})
      else()
        # imported targets are directory-scoped, so map the ones the daemons use to plain libraries
        foreach(l IN LISTS v)
          if(TARGET ${l})
            target_link_libraries(${out} PUBLIC ${l})
            target_link_libraries(${out}_auth PUBLIC ${l})
          elseif(l STREQUAL "OpenSSL::SSL")
            target_link_libraries(${out} PUBLIC ssl)
            target_link_libraries(${out}_auth PUBLIC ssl)
          elseif(l STREQUAL "OpenSSL::Crypto")
            target_link_libraries(${out} PUBLIC crypto)
            target_link_libraries(${out}_auth PUBLIC crypto)
          elseif(l STREQUAL "ZLIB::ZLIB")
            target_link_libraries(${out} PUBLIC z)
            target_link_libraries(${out}_auth PUBLIC z)
          else()
            message(FATAL_ERROR "mayhem: unmapped link library ${l} of ${tgt}")
          endif()
        endforeach()
      endif()
    endif()
  endforeach()
endfunction()

